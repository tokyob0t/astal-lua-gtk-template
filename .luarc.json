{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "diagnostics": {
        "disableScheme": ["@luagir/", "build", "dist"],
        "disable": ["param-type-mismatch"]
    },
    "completion": {
        "callSnippet": "Both",
        "keywordSnippet": "Both"
    },
    "workspace": {
        "library": ["@luagir/", "/usr/share/lua/5.1/", "venv/share/lua/5.1/"],
        "maxPreload": 2000,
        "preloadFileSize": 1000,
        "ignoreDir": ["@luagir/", "build", "dist"]
    },
    "runtime": {
        "version": "LuaJIT",
        "path": ["./src/?.lua", "./src/?/init.lua"],
        "pathStrict": true
    }
}
